# ============================================================
# LEXLENS ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and set your appropriate credentials.
# ============================================================

# Environment
ENV=development
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Google Gemini API Key (Optional)
# If left blank, LexLens automatically activates its deterministic local
# legal NLP extraction engine for offline reliability with zero crashes.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Platform (Optional)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Max Upload Size (Bytes, default 10MB)
MAX_FILE_SIZE_BYTES=10485760
